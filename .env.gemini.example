# docker compose --env-file .env.gemini.example up
# Gemini đi qua endpoint OpenAI-compatible (xem ChatClientFactory).
# Endpoint set tường minh vì docker-compose luôn truyền Ai__*__Endpoint xuống container
# (rỗng chứ không phải null), nên nhánh `endpoint ?? default` trong factory không chạy.
Ai__Chat__Provider=Google
Ai__Chat__Model=gemini-2.5-flash
# Bỏ trống dòng này với model dòng reasoning: chúng chỉ nhận temperature mặc định.
Ai__Chat__Temperature=0.2
Ai__Chat__Endpoint=https://generativelanguage.googleapis.com/v1beta/openai/
Ai__UtilityChat__Provider=Google
Ai__UtilityChat__Model=gemini-2.5-flash-lite
Ai__UtilityChat__Endpoint=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding vẫn để OpenAI: schema đang cố định vector(1536), trong khi
# ProviderCapabilities.For(EmbeddingProvider.Google) đặt SupportsEmbeddingDimensions=false
# nên tham số dimensions không được gửi đi và gemini-embedding-001 sẽ trả 3072 chiều.
# Muốn dùng embedding của Google thì phải thêm migration đổi kiểu cột rồi reindex (xem README).
Ai__Embedding__Provider=OpenAI
Ai__Embedding__Model=text-embedding-3-small

# Chat dùng key Google, embedding dùng key OpenAI — hai hãng khác nhau, hai key khác nhau.
Ai__Chat__ApiKey=AQ.thay-bang-key-that
Ai__Embedding__ApiKey=sk-thay-bang-key-that

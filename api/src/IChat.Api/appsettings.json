{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ichat;Username=ichat;Password=ichat"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Storage": {
    "RootPath": "/data/documents"
  },
  "Ai": {
    "Chat": {
      "Provider": "OpenAI",
      "Model": "gpt-4o-mini",
      "MaxOutputTokens": 2048,
      "TimeoutSeconds": 120,
      "Endpoint": null,
      "ApiKey": null
    },
    "UtilityChat": {
      "Provider": null,
      "Model": "gpt-4o-mini",
      "MaxOutputTokens": 256,
      "TimeoutSeconds": 15
    },
    "Embedding": {
      "Provider": "OpenAI",
      "Model": "text-embedding-3-small",
      "Dimensions": 1536,
      "BatchSize": 64,
      "TimeoutSeconds": 60,
      "ApiKey": null
    },
    "Pipeline": {
      "EnableCaching": true,
      "EnableOpenTelemetry": true,
      "EnableFunctionInvocation": false,
      "MaxRetryAttempts": 3
    },
    "AllowedChatModels": []
  },
  "Rag": {
    "Chunking": {
      "TargetTokens": 800,
      "OverlapTokens": 120,
      "MinTokens": 80,
      "PrependHeadingPath": true
    },
    "QueryRewriting": {
      "Enabled": true,
      "HistoryTurns": 3,
      "SkipOnFirstTurn": true,
      "MaxOutputTokens": 128
    },
    "Retrieval": {
      "VectorCandidates": 40,
      "FullTextCandidates": 40,
      "TrigramCandidates": 0,
      "VectorMinSimilarity": 0.20,
      "FullTextMinRank": 0.01,
      "RrfK": 60,
      "FusedTopK": 20
    },
    "Diversity": {
      "MmrLambda": 0.7,
      "MaxChunksPerDocument": 3,
      "FinalTopK": 8
    },
    "NeighborExpansion": {
      "Enabled": true,
      "Before": 1,
      "After": 1
    },
    "Reranking": {
      "Mode": "None",
      "InputTopK": 20,
      "OutputTopK": 8
    },
    "Context": {
      "MaxTokens": 6000,
      "HistoryTurns": 6
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    "Properties": {
      "Application": "IChat.Api"
    }
  },
  "AllowedHosts": "*"
}

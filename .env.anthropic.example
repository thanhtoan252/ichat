# docker compose --env-file .env.anthropic.example up
# Anthropic KHÔNG có embedding API, nên embedding vẫn phải lấy từ nhà cung cấp khác.
Ai__Chat__Provider=Anthropic
Ai__Chat__Model=claude-sonnet-5
# Bỏ trống dòng này với model dòng reasoning: chúng chỉ nhận temperature mặc định.
Ai__Chat__Temperature=0.2
Ai__UtilityChat__Provider=Anthropic
Ai__UtilityChat__Model=claude-haiku-4-5
Ai__Embedding__Provider=OpenAI
Ai__Embedding__Model=text-embedding-3-small
# Chat dùng key Anthropic, embedding dùng key OpenAI — hai hãng khác nhau, hai key khác nhau.
Ai__Chat__ApiKey=sk-ant-thay-bang-key-that
Ai__Embedding__ApiKey=sk-thay-bang-key-that

# Khoá ký JWT, tối thiểu 32 ký tự.
Jwt__SigningKey=doi-chuoi-nay-thanh-mot-khoa-ngau-nhien-dai-32-ky-tu

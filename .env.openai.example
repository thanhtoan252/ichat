# docker compose --env-file .env.openai.example up
Ai__Chat__Provider=OpenAI
Ai__Chat__Model=gpt-4o-mini
# Bỏ trống dòng này với model dòng reasoning: chúng chỉ nhận temperature mặc định.
Ai__Chat__Temperature=0.2
Ai__UtilityChat__Provider=OpenAI
Ai__UtilityChat__Model=gpt-4o-mini
Ai__Embedding__Provider=OpenAI
Ai__Embedding__Model=text-embedding-3-small
Ai__Chat__ApiKey=sk-thay-bang-key-that
Ai__Embedding__ApiKey=sk-thay-bang-key-that

    "@angular/router": "^22.0.0",
    "@ng-icons/core": "^35.1.0",
    "@ng-icons/lucide": "^35.1.0",
    "@spartan-ng/brain": "^1.3.4",
    "class-variance-authority": "^0.7.1",

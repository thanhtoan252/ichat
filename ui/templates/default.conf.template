# Rendered by the nginx image's entrypoint: every file under /etc/nginx/templates is
# run through envsubst into /etc/nginx/conf.d with the .template suffix dropped.
# NGINX_ENVSUBST_FILTER limits substitution to ICHAT_* so nginx's own $host,
# $remote_addr and friends survive untouched.
#
# ICHAT_API_UPSTREAM is host:port, not a URL. It defaults to the compose service
# (api:8080); point it at host.docker.internal:8080 to serve the UI from Docker
# while the API runs on the host under a debugger.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The API's own validator rejects anything over 50MB with a readable message;
    # leaving headroom here keeps nginx from answering with a bare 413 first.
    client_max_body_size 55m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # `^~` stops nginx from testing the regex location below, so an API path that
    # happens to end in .json or .svg is still proxied instead of looked up on disk.
    location ^~ /api/ {
        proxy_pass http://${ICHAT_API_UPSTREAM};
        include /etc/nginx/conf.d/ichat-proxy.inc;
    }

    location ^~ /health/ {
        proxy_pass http://${ICHAT_API_UPSTREAM};
        include /etc/nginx/conf.d/ichat-proxy.inc;
    }

    # Hashed filenames from the production build are safe to cache forever.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        # index.html must never be cached, or a deploy leaves clients on stale bundles.
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
